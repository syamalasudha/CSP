# Express server port
PORT=3000

# MongoDB connection string (local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/digital_panchayat

# Secret used to sign admin JWT tokens (change this in production)
JWT_SECRET=change_this_to_a_strong_secret_key

# Comma-separated list of allowed frontend origins (e.g. https://your-app.vercel.app)
CORS_ORIGIN=http://localhost:5173

